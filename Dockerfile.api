# Slim API image: serves the knowledge graph + the template-backed /brief route
# without the ML training stack.
FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

COPY . .
RUN pip install --no-cache-dir --no-deps .

CMD ["uvicorn", "argus.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
