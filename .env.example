# Copy to .env and fill in. Everything works with defaults + no keys.
ARGUS_DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5433/argus

# LLM backend for the analyst agent:
#   auto (default) -> Claude if a key is present, else local (ollama), else deterministic template
#   anthropic | ollama | mlx | template
ARGUS_LLM_BACKEND=auto

# Optional: enables the Claude-backed agent when ARGUS_LLM_BACKEND is auto/anthropic.
# Without it, ARGUS runs the deterministic extractive briefer (no key, no cost).
ANTHROPIC_API_KEY=

# Optional: local model server (used when backend is ollama)
ARGUS_OLLAMA_URL=http://localhost:11434
ARGUS_OLLAMA_MODEL=llama3.1

# Optional: bridge to the sibling SENTINEL cyber knowledge-graph API (read-only).
# Empty disables the query_cyber_graph agent tool.
ARGUS_SENTINEL_API_URL=
