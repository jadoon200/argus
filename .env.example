# Copy to .env and fill in. Everything works with defaults + no keys.
ARGUS_DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5433/argus

# LLM backend for the analyst agent — free by default, paid strictly opt-in:
#   auto (default) -> local Ollama if reachable, else the deterministic template.
#                     auto NEVER selects a remote/paid backend, even if a key is set.
#   anthropic | ollama | mlx | openai | template
ARGUS_LLM_BACKEND=auto

# Paid Claude backend (opt-in ONLY): used solely when ARGUS_LLM_BACKEND=anthropic
# AND this key is set. Leave both unset to guarantee zero cost — ARGUS then runs
# local Ollama or the deterministic extractive briefer.
ARGUS_ANTHROPIC_API_KEY=

# Optional: local model server (used when backend is ollama)
ARGUS_OLLAMA_URL=http://localhost:11434
ARGUS_OLLAMA_MODEL=llama3.1

# Optional evaluation polish: `make eval-multiseed` sets three seeds automatically.
# Set this directly only when invoking `make eval` and you want repeated seeded runs.
# ARGUS_EVAL_SEEDS=7,19,43

# Lean supervisor: OSINT is the base lane; only relevant Sky/Ocean/Cyber workers wake.
# These live APIs are read-only. Replace with local sibling URLs when running all four.
ARGUS_FUSION_SUPERVISOR=true
ARGUS_HORUS_API_URL=https://horus-kc7w.onrender.com
ARGUS_PHAROS_API_URL=https://pharos-0y6q.onrender.com
ARGUS_SENTINEL_API_URL=https://sentinel-92pf.onrender.com
# ARGUS_HORUS_API_URL=http://localhost:8001
# ARGUS_PHAROS_API_URL=http://localhost:8002
# ARGUS_SENTINEL_API_URL=http://localhost:8003

# Cache the overview fan-out so opening the tab does not hammer free-tier siblings.
ARGUS_FUSION_OVERVIEW_CACHE_SECONDS=60
