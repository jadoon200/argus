# Full-stack single-container image for a free public deployment: builds the React
# dashboard and serves it from the same FastAPI process as the API — one service, one
# origin, no CORS, no separate database server (SQLite file). Pins the template backend,
# so it runs with no LLM and no API key. Build:  docker build -f Dockerfile.web -t argus .

# --- stage 1: build the dashboard -----------------------------------------------------
FROM node:20-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# A production build => import.meta.env.PROD, so the client calls the API same-origin.
RUN npm run build

# --- stage 2: API + the built dashboard -----------------------------------------------
FROM python:3.12-slim AS app
WORKDIR /app

# Slim runtime (no ML stack); the demo pins ARGUS_LLM_BACKEND=template.
COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

COPY . .
RUN pip install --no-cache-dir --no-deps .
COPY --from=web /web/dist ./frontend/dist

# Bake a small demo corpus into the image so the site isn't empty on first load.
ENV ARGUS_DATABASE_URL=sqlite:////app/data/argus.db
RUN mkdir -p /app/data && python scripts/seed_demo.py

# Free-demo posture: template engine (no key, no cost) and answer from the baked corpus
# rather than fetching + embedding on demand (the slim image has no embedding model).
ENV ARGUS_LLM_BACKEND=template \
    ARGUS_AUTO_COLLECT=false \
    ARGUS_API_TRUST_FORWARDED_HEADER=true \
    PORT=8000
EXPOSE 8000

# Shell form so $PORT (set by most free hosts, e.g. Render) is honoured.
CMD uvicorn argus.api.app:app --host 0.0.0.0 --port ${PORT:-8000}
